# 시세 프록시 설정 (server/index.js).
# 이 파일을 .env 로 복사한 뒤, 쓰려는 provider의 키만 채우세요.
# .env 는 .gitignore에 의해 커밋되지 않습니다.

# 사용할 데이터 제공처: sim | twelvedata | kis  (미설정 시 sim)
DATA_PROVIDER=sim

# 프록시 포트 / 캐시 TTL(ms)
PORT=8787
CACHE_TTL_MS=5000

# ── Twelve Data (국내 KRX + 해외, 무료 키) ──
# https://twelvedata.com 가입 → API Key
# TWELVEDATA_API_KEY=your_key_here

# ── 한국투자증권 KIS (국내 + 해외, 무료 / 증권계좌 필요) ──
# https://apiportal.koreainvestment.com 에서 앱 등록 후 발급
# KIS_APP_KEY=your_app_key
# KIS_APP_SECRET=your_app_secret
# KIS_BASE=https://openapi.koreainvestment.com:9443
